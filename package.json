{
  "name": "farwa-beauty-salon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "browserslist": [
    "chrome >= 92",
    "firefox >= 92",
    "safari >= 15.4",
    "edge >= 92",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node ./node_modules/vitest/vitest.mjs run src/gbp-stats-freshness.test.js src/prices-freshness.test.js",
    "start": "next start",
    "lint": "eslint .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run build && playwright test",
    "verify": "npm run lint && npm run test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "ping:indexnow": "node scripts/ping-indexnow.mjs",
    "qa:workflow": "node scripts/qa-workflow-run.mjs",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.32.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.12",
    "sharp": "^0.35.3"
  }
}
