# Google Sheets (online booking)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Booking cancellation links (required for self-service cancel)
BOOKING_CANCEL_SECRET=

# Optional: comma-separated preview Origins for booking CSRF allowlist
# (e.g. https://farwasalon-git-branch-team.vercel.app). Production alias
# farwasalon.vercel.app and the current VERCEL_URL are allowed automatically.
# ALLOWED_BOOKING_ORIGINS=

# Google Places API (homepage reviews — server-only, never NEXT_PUBLIC_)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJeVyXMig_szoQEKI0TaSkW-U

# JSON-LD rating overrides (optional; sync from Places API or GBP)
SALON_GBP_RATING=4.6
SALON_GBP_REVIEW_COUNT=19

# IndexNow (optional)
INDEXNOW_SECRET=

# Which request header carries the real client IP. Defaults to
# x-vercel-forwarded-for, which is correct ON Vercel and absent anywhere else —
# and when it is absent every visitor shares one rate-limit bucket capped at 2.
# Set this to whatever your proxy actually sets (x-real-ip behind nginx,
# cf-connecting-ip behind Cloudflare) if you deploy off Vercel. Naming one
# header is safe; a fallback chain is not, because an attacker can rotate them.
TRUSTED_IP_HEADER=
